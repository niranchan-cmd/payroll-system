# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Local:
DATABASE_URL="postgresql://username@localhost:5432/payroll_dev?schema=public"

# Neon (production) — create a project at https://neon.tech, copy the pooler URL:
# DATABASE_URL="postgresql://neondb_owner:<password>@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_payroll_jwt_secret_2026
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION_payroll_refresh_secret_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── FRONTEND (CORS) ──────────────────────────────────────────────────────────
# Local:
CLIENT_URL=http://localhost:5173
# Production (your Vercel frontend URL):
# CLIENT_URL=https://payroll-os.vercel.app

# ─── VERCEL ───────────────────────────────────────────────────────────────────
# Set by Vercel automatically — do not set manually:
# VERCEL=1
